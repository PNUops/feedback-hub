#!/usr/bin/env bash
# commit-msg hook: enforce the shared convention.
# type: subject, imperative, <=72 chars, no trailing period, no em dash,
# no AI attribution trailers.
set -u
msg_file=$1
subject=$(head -1 "$msg_file")

fail() { echo "commit-msg: $*" >&2; exit 1; }

# Allow merge/revert/fixup autogenerated subjects.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types='feat|fix|docs|test|chore|refactor|perf|build|style|ci|revert|merge'
[[ "$subject" =~ ^($types):\ .+ ]] || fail "subject must be 'type: subject' ($types)"
[ "${#subject}" -le 72 ] || fail "subject exceeds 72 chars (${#subject})"
[[ "$subject" != *. ]] || fail "subject must not end with a period"
case "$subject" in *"—"*) fail "subject must not contain an em dash" ;; esac

# No AI attribution anywhere in the message.
if grep -qiE 'co-authored-by:.*(claude|anthropic)|generated with|claude\.ai|anthropic' "$msg_file"; then
  fail "message must not include AI attribution"
fi
exit 0
