# --- 공개 도메인 ---
DOMAIN=feedback.pnuops.com
NEXT_PUBLIC_SITE_URL=https://feedback.pnuops.com

# --- 관리자 passcode (관리 기능 게이트) ---
ADMIN_PASSWORD=change-me

# --- PostgreSQL ---
POSTGRES_USER=feedback
POSTGRES_PASSWORD=change-me
POSTGRES_DB=feedback
# 앱 컨테이너에서 접속(컴포즈 네트워크의 컨테이너명 사용)
DATABASE_URL=postgresql://feedback:change-me@feedback-postgres:5432/feedback

# --- 파일 업로드 ---
FILE_STORAGE_DIR=/app/data/files
FILE_UPLOAD_MAX=10485760

# --- 이메일 알림 (선택; 미설정이면 알림 비활성) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=feedback-hub <no-reply@pnuops.com>
# ADMIN_NOTIFY_EMAIL=dev@example.com
